{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",

    // ✅ Speed: incremental builds
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    // ✅ Speed: isolated file compilation
    "isolatedModules": true,

    // ✅ Correctness
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    // ✅ Output: declarations only if you're publishing a package
    "declaration": true,
    "declarationMap": false,  // drop unless publishing
    "sourceMap": true,

    // ✅ Types: explicit, no typeRoots
    "types": ["jest", "node"],

   
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests"]
}